#!/bin/sh

CONFIG="/etc/kidtime/config"

echo "Content-Type: application/json"
echo "Cache-Control: no-store"
echo ""

url_decode() {
    printf '%b' "$(printf '%s' "$1" | sed 's/+/ /g; s/%/\\x/g')"
}

get_param() {
    RAW="$(printf '%s' "$QUERY_STRING" | tr '&' '\n' | sed -n "s/^$1=//p" | head -n 1)"
    url_decode "$RAW"
}

json_escape() {
    printf '%s' "$1" | sed 's/\\/\\\\/g; s/"/\\"/g'
}

valid_time() {
    echo "$1" | grep -Eq '^([01][0-9]|2[0-3]):[0-5][0-9]$'
}

valid_limit() {
    case "$1" in
        ''|*[!0-9]*)
            return 1
            ;;
    esac

    [ "$1" -ge 1 ] && [ "$1" -le 1440 ]
}

valid_domain() {
    echo "$1" | grep -Eq '^([A-Za-z0-9-]+\.)+[A-Za-z]{2,}$'
}

json_config() {
    . "$CONFIG"

    printf '{'
    printf '"MON_START":"%s",' "$(json_escape "$MON_START")"
    printf '"MON_END":"%s",' "$(json_escape "$MON_END")"
    printf '"MON_LIMIT":%s,' "$MON_LIMIT"

    printf '"TUE_START":"%s",' "$(json_escape "$TUE_START")"
    printf '"TUE_END":"%s",' "$(json_escape "$TUE_END")"
    printf '"TUE_LIMIT":%s,' "$TUE_LIMIT"

    printf '"WED_START":"%s",' "$(json_escape "$WED_START")"
    printf '"WED_END":"%s",' "$(json_escape "$WED_END")"
    printf '"WED_LIMIT":%s,' "$WED_LIMIT"

    printf '"THU_START":"%s",' "$(json_escape "$THU_START")"
    printf '"THU_END":"%s",' "$(json_escape "$THU_END")"
    printf '"THU_LIMIT":%s,' "$THU_LIMIT"

    printf '"FRI_START":"%s",' "$(json_escape "$FRI_START")"
    printf '"FRI_END":"%s",' "$(json_escape "$FRI_END")"
    printf '"FRI_LIMIT":%s,' "$FRI_LIMIT"

    printf '"SAT_START":"%s",' "$(json_escape "$SAT_START")"
    printf '"SAT_END":"%s",' "$(json_escape "$SAT_END")"
    printf '"SAT_LIMIT":%s,' "$SAT_LIMIT"

    printf '"SUN_START":"%s",' "$(json_escape "$SUN_START")"
    printf '"SUN_END":"%s",' "$(json_escape "$SUN_END")"
    printf '"SUN_LIMIT":%s' "$SUN_LIMIT"
    printf '}\n'
}

save_config() {
    MON_START_NEW="$(get_param MON_START)"
    MON_END_NEW="$(get_param MON_END)"
    MON_LIMIT_NEW="$(get_param MON_LIMIT)"

    TUE_START_NEW="$(get_param TUE_START)"
    TUE_END_NEW="$(get_param TUE_END)"
    TUE_LIMIT_NEW="$(get_param TUE_LIMIT)"

    WED_START_NEW="$(get_param WED_START)"
    WED_END_NEW="$(get_param WED_END)"
    WED_LIMIT_NEW="$(get_param WED_LIMIT)"

    THU_START_NEW="$(get_param THU_START)"
    THU_END_NEW="$(get_param THU_END)"
    THU_LIMIT_NEW="$(get_param THU_LIMIT)"

    FRI_START_NEW="$(get_param FRI_START)"
    FRI_END_NEW="$(get_param FRI_END)"
    FRI_LIMIT_NEW="$(get_param FRI_LIMIT)"

    SAT_START_NEW="$(get_param SAT_START)"
    SAT_END_NEW="$(get_param SAT_END)"
    SAT_LIMIT_NEW="$(get_param SAT_LIMIT)"

    SUN_START_NEW="$(get_param SUN_START)"
    SUN_END_NEW="$(get_param SUN_END)"
    SUN_LIMIT_NEW="$(get_param SUN_LIMIT)"

    for T in \
        "$MON_START_NEW" "$MON_END_NEW" \
        "$TUE_START_NEW" "$TUE_END_NEW" \
        "$WED_START_NEW" "$WED_END_NEW" \
        "$THU_START_NEW" "$THU_END_NEW" \
        "$FRI_START_NEW" "$FRI_END_NEW" \
        "$SAT_START_NEW" "$SAT_END_NEW" \
        "$SUN_START_NEW" "$SUN_END_NEW"
    do
        if ! valid_time "$T"; then
            echo '{"ok":false,"error":"invalid_time"}'
            return
        fi
    done

    for L in \
        "$MON_LIMIT_NEW" "$TUE_LIMIT_NEW" "$WED_LIMIT_NEW" \
        "$THU_LIMIT_NEW" "$FRI_LIMIT_NEW" "$SAT_LIMIT_NEW" "$SUN_LIMIT_NEW"
    do
        if ! valid_limit "$L"; then
            echo '{"ok":false,"error":"invalid_limit"}'
            return
        fi
    done

    for KEY in \
        MON_START MON_END MON_LIMIT TUE_START TUE_END TUE_LIMIT \
        WED_START WED_END WED_LIMIT THU_START THU_END THU_LIMIT \
        FRI_START FRI_END FRI_LIMIT SAT_START SAT_END SAT_LIMIT \
        SUN_START SUN_END SUN_LIMIT
    do
        if ! grep -q "^${KEY}=" "$CONFIG"; then
            echo "{\"ok\":false,\"error\":\"missing_config_key\",\"key\":\"$KEY\"}"
            return
        fi
    done

    TMP="${CONFIG}.tmp.$$"
    cp "$CONFIG" "$TMP" || {
        echo '{"ok":false,"error":"copy_failed"}'
        return
    }

    sed -i \
        -e "s/^MON_START=.*/MON_START=\"$MON_START_NEW\"/" \
        -e "s/^MON_END=.*/MON_END=\"$MON_END_NEW\"/" \
        -e "s/^MON_LIMIT=.*/MON_LIMIT=$MON_LIMIT_NEW/" \
        -e "s/^TUE_START=.*/TUE_START=\"$TUE_START_NEW\"/" \
        -e "s/^TUE_END=.*/TUE_END=\"$TUE_END_NEW\"/" \
        -e "s/^TUE_LIMIT=.*/TUE_LIMIT=$TUE_LIMIT_NEW/" \
        -e "s/^WED_START=.*/WED_START=\"$WED_START_NEW\"/" \
        -e "s/^WED_END=.*/WED_END=\"$WED_END_NEW\"/" \
        -e "s/^WED_LIMIT=.*/WED_LIMIT=$WED_LIMIT_NEW/" \
        -e "s/^THU_START=.*/THU_START=\"$THU_START_NEW\"/" \
        -e "s/^THU_END=.*/THU_END=\"$THU_END_NEW\"/" \
        -e "s/^THU_LIMIT=.*/THU_LIMIT=$THU_LIMIT_NEW/" \
        -e "s/^FRI_START=.*/FRI_START=\"$FRI_START_NEW\"/" \
        -e "s/^FRI_END=.*/FRI_END=\"$FRI_END_NEW\"/" \
        -e "s/^FRI_LIMIT=.*/FRI_LIMIT=$FRI_LIMIT_NEW/" \
        -e "s/^SAT_START=.*/SAT_START=\"$SAT_START_NEW\"/" \
        -e "s/^SAT_END=.*/SAT_END=\"$SAT_END_NEW\"/" \
        -e "s/^SAT_LIMIT=.*/SAT_LIMIT=$SAT_LIMIT_NEW/" \
        -e "s/^SUN_START=.*/SUN_START=\"$SUN_START_NEW\"/" \
        -e "s/^SUN_END=.*/SUN_END=\"$SUN_END_NEW\"/" \
        -e "s/^SUN_LIMIT=.*/SUN_LIMIT=$SUN_LIMIT_NEW/" \
        "$TMP"

    if ! sh -n "$TMP"; then
        rm -f "$TMP"
        echo '{"ok":false,"error":"config_syntax_error"}'
        return
    fi

    chmod 600 "$TMP" || {
        rm -f "$TMP"
        echo '{"ok":false,"error":"chmod_failed"}'
        return
    }

    mv "$TMP" "$CONFIG" || {
        rm -f "$TMP"
        echo '{"ok":false,"error":"replace_failed"}'
        return
    }

    /usr/bin/kidtime tick >/dev/null 2>&1

    echo '{"ok":true}'
}

ACTION="$(get_param action)"

case "$ACTION" in
    status)
        /usr/bin/kidtime status-json
        ;;

    config)
        json_config
        ;;

    add-time)
        MINUTES="$(get_param minutes)"

        case "$MINUTES" in
            ''|*[!0-9]*)
                echo '{"ok":false,"error":"invalid_minutes"}'
                exit 0
                ;;
        esac

        if [ "$MINUTES" -lt 1 ] || [ "$MINUTES" -gt 1440 ]; then
            echo '{"ok":false,"error":"minutes_out_of_range"}'
            exit 0
        fi

        if /usr/bin/kidtime add "$MINUTES" >/dev/null 2>&1; then
            echo '{"ok":true}'
        else
            echo '{"ok":false,"error":"add_time_failed"}'
        fi
        ;;

    save-config)
        save_config
        ;;

    kidblock-status)
        STATUS_OUT="$(/usr/bin/kidblock status 2>/dev/null)"

        case "$STATUS_OUT" in
            *ON*|*enabled*|*ENABLED*)
                echo '{"ok":true,"enabled":true}'
                ;;
            *OFF*|*disabled*|*DISABLED*)
                echo '{"ok":true,"enabled":false}'
                ;;
            *)
                echo '{"ok":false,"error":"kidblock_status_unknown"}'
                ;;
        esac
        ;;

    kidblock-list)
        echo '{"ok":true,"domains":['
        FIRST=1

        /usr/bin/kidblock list 2>/dev/null | sed '1d' | while IFS= read -r DOMAIN
        do
            case "$DOMAIN" in
                ''|'(empty)') continue ;;
            esac

            if [ "$FIRST" -eq 1 ]; then
                FIRST=0
            else
                printf ','
            fi

            printf '"%s"' "$(json_escape "$DOMAIN")"
        done

        echo ']}'
        ;;

    kidblock-on)
        if /usr/bin/kidblock on >/dev/null 2>&1; then
            echo '{"ok":true,"enabled":true}'
        else
            echo '{"ok":false,"error":"kidblock_on_failed"}'
        fi
        ;;

    kidblock-off)
        if /usr/bin/kidblock off >/dev/null 2>&1; then
            echo '{"ok":true,"enabled":false}'
        else
            echo '{"ok":false,"error":"kidblock_off_failed"}'
        fi
        ;;

    kidblock-add)
        DOMAIN="$(get_param domain)"

        if ! valid_domain "$DOMAIN"; then
            echo '{"ok":false,"error":"invalid_domain"}'
            exit 0
        fi

        if /usr/bin/kidblock add "$DOMAIN" >/dev/null 2>&1; then
            echo '{"ok":true}'
        else
            echo '{"ok":false,"error":"kidblock_add_failed"}'
        fi
        ;;

    kidblock-del)
        DOMAIN="$(get_param domain)"

        if ! valid_domain "$DOMAIN"; then
            echo '{"ok":false,"error":"invalid_domain"}'
            exit 0
        fi

        if /usr/bin/kidblock del "$DOMAIN" >/dev/null 2>&1; then
            echo '{"ok":true}'
        else
            echo '{"ok":false,"error":"kidblock_del_failed"}'
        fi
        ;;

    master-status)
        MASTER="$(/usr/bin/kidtime master-status 2>/dev/null)"
        if [ "$MASTER" = "ON" ]; then
            echo '{"ok":true,"enabled":true}'
        elif [ "$MASTER" = "OFF" ]; then
            echo '{"ok":true,"enabled":false}'
        else
            echo '{"ok":false,"error":"master_status_unknown"}'
        fi
        ;;

    master-on)
        if /usr/bin/kidtime master-on >/dev/null 2>&1; then
            echo '{"ok":true,"enabled":true}'
        else
            echo '{"ok":false,"error":"master_on_failed"}'
        fi
        ;;

    master-off)
        if /usr/bin/kidtime master-off >/dev/null 2>&1; then
            echo '{"ok":true,"enabled":false}'
        else
            echo '{"ok":false,"error":"master_off_failed"}'
        fi
        ;;

    *)
        echo '{"ok":false,"error":"unknown_action"}'
        ;;
esac
